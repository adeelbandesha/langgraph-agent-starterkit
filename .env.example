# Copy this file to .env and fill in the values you need:
#   cp .env.example .env
# Real environment variables take precedence over values in .env.

#Provider
# Which LLM backend drives all three agents: "anthropic" or "openai".
LLM_PROVIDER=anthropic

# API key for the provider selected above. Only that one is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Point the openai provider at any OpenAI-compatible API (Groq, Gemini, OpenRouter, Ollama).
# Keep it commented out for OpenAI itself: an empty value breaks the client.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

#Model
# Leave empty to use the default: claude-sonnet-5-5 (anthropic) or gpt-4.1 (openai).
LLM_MODEL=

# Sampling temperature, 0.0-2.0. Leave empty to use the model's own default
# (some models reject an explicit temperature).
LLM_TEMPERATURE=

# Maximum tokens per response. Generated modules can be long, so keep this generous.
LLM_MAX_TOKENS=8192

# Retries for failed or rate-limited calls. The client waits as long as the provider asks
# between attempts, so free tiers with per-minute limits (e.g. Groq) need several.
LLM_MAX_RETRIES=6

#Pipeline
# How many implement -> QA rounds to allow before stopping without approval (1-10).
MAX_QA_ITERATIONS=3

#Logging
# DEBUG, INFO, WARNING or ERROR. The --verbose flag forces DEBUG.
LOG_LEVEL=INFO
