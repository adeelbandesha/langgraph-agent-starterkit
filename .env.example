# Copy this file to .env and fill in the values you need:
#   cp .env.example .env
# Real environment variables take precedence over values in .env.

# --- Provider -------------------------------------------------------------
# Which LLM backend drives all three agents: "anthropic" or "openai".
LLM_PROVIDER=anthropic

# API key for the provider selected above. Only that one is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Model ----------------------------------------------------------------
# Leave empty to use the default: claude-sonnet-5-5 (anthropic) or gpt-4.1 (openai).
LLM_MODEL=

# Sampling temperature, 0.0-2.0. Leave empty to use the model's own default
# (some models reject an explicit temperature).
LLM_TEMPERATURE=

# Maximum tokens per response. Generated modules can be long, so keep this generous.
LLM_MAX_TOKENS=8192

# --- Pipeline -------------------------------------------------------------
# How many implement -> QA rounds to allow before stopping without approval (1-10).
MAX_QA_ITERATIONS=3

# --- Logging --------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR. The --verbose flag forces DEBUG.
LOG_LEVEL=INFO
